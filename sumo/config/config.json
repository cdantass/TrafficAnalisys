    "adaptativo": {
      "espera_pedestre_extensao_gatilho_s": 15,
      "extensao_verde_pedestre_s": 8,
      "distancia_deteccao_ambulancia_m": 150,
      "limite_fila_veiculos": 8,
      "incremento_verde_fila_s": 10,
      "verde_minimo_s": 10,
      "verde_maximo_s": 60
    }
  },

  "logs": {
    "diretorio_saida": "logs/",
    "formato": "csv"
  }
