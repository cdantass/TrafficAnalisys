{
  "_comentario": "Parametros centrais do sistema. Nada aqui deve ficar hardcoded no codigo Python (etapa 2). Este arquivo ja pode ser versionado e ajustado conforme os experimentos do TCC.",

  "sumo": {
    "config_file": "config/simulation.sumocfg",
    "gui": true,
    "step_length_s": 1
  },

