<?xml version="1.0" encoding="UTF-8"?>
<!--
  Veículos comuns cruzando o cruzamento C nas 4 abordagens, com movimentos
  de seguir em frente, virar à esquerda e virar à direita.

  Intensidade do fluxo (vehsPerHour) é controlada aqui. Para trocar entre
  baixo/médio/alto, ajuste os valores de vehsPerHour de cada <flow> (ou
  gere variantes deste arquivo por script no controlador Python — ver
  seção "cenários" do config.json).

  Convenção de nomes de rota: <origem>_<destino>, ex.: N_S = vindo do
  Norte, saindo ao Sul (segue em frente).
-->
<routes>
    <vType id="car" vClass="passenger" length="4.5" minGap="2.5"
           maxSpeed="13.89" accel="2.6" decel="4.5" sigma="0.5"/>

    <!-- rotas possíveis através do cruzamento -->
    <route id="N_S" edges="N_C C_S"/>
    <route id="N_E" edges="N_C C_E"/>
    <route id="N_W" edges="N_C C_W"/>

    <route id="S_N" edges="S_C C_N"/>
    <route id="S_E" edges="S_C C_E"/>
    <route id="S_W" edges="S_C C_W"/>

    <route id="E_W" edges="E_C C_W"/>
    <route id="E_N" edges="E_C C_N"/>
    <route id="E_S" edges="E_C C_S"/>

    <route id="W_E" edges="W_C C_E"/>
    <route id="W_N" edges="W_C C_N"/>
    <route id="W_S" edges="W_C C_S"/>

    <!-- fluxo MÉDIO por padrão em todas as direções (editar vehsPerHour
         para simular baixo ~ 100-150, médio ~ 300-400, alto ~ 600-800) -->
    <flow id="flow_N_S" route="N_S" type="car" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_N_E" route="N_E" type="car" begin="0" end="3600" vehsPerHour="80"/>
    <flow id="flow_N_W" route="N_W" type="car" begin="0" end="3600" vehsPerHour="80"/>

    <flow id="flow_S_N" route="S_N" type="car" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_S_E" route="S_E" type="car" begin="0" end="3600" vehsPerHour="80"/>
    <flow id="flow_S_W" route="S_W" type="car" begin="0" end="3600" vehsPerHour="80"/>

    <flow id="flow_E_W" route="E_W" type="car" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_E_N" route="E_N" type="car" begin="0" end="3600" vehsPerHour="80"/>
    <flow id="flow_E_S" route="E_S" type="car" begin="0" end="3600" vehsPerHour="80"/>

    <flow id="flow_W_E" route="W_E" type="car" begin="0" end="3600" vehsPerHour="300"/>
    <flow id="flow_W_N" route="W_N" type="car" begin="0" end="3600" vehsPerHour="80"/>
    <flow id="flow_W_S" route="W_S" type="car" begin="0" end="3600" vehsPerHour="80"/>
</routes>
